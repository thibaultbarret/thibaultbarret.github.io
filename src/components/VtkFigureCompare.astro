---
// VtkFigureCompare — 2 ou 3 sous-figures 2D à colormap/échelle partagée.
// JSON : voir docs/superpowers/specs/2026-06-05-vtk-figure-compare-design.md
//   { cmap, n_colors, opacity, label_format, label_color, vmin?, vmax?,
//     fields_config | field_index/field_name, steps[],
//     panels: [ { title, coords, triangles, fields, displacements?, images?|image? } ] }
//   columns?: nombre de colonnes de la grille de panneaux (défaut : tout sur une ligne)
import VtkPlayerBar from './VtkPlayerBar.astro';

interface Props { src: string; height?: number | string; }
const { src, height = 450 } = Astro.props;
const heightCss = typeof height === 'string' ? height : `${height}px`;
---

<div
  class="vtkc-figure"
  data-src={src}
  style={`height:${heightCss}; box-sizing:border-box; padding:12px; display:flex; flex-direction:column; overflow:hidden; background:#1e1e2e; border-radius:0.25rem; position:relative;`}
>
  <!-- Spinner -->
  <div class="vtkc-loading" style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;z-index:20;">
    <span style="color:#a6adc8;font:12px monospace;">Chargement…</span>
  </div>

  <!-- Zone haute : panneaux (texte propre intégré) + colorbar -->
  <div style="flex:1; display:flex; overflow:hidden; position:relative; min-height:0;">

    <!-- Rangée de panneaux (remplie dynamiquement par le script) -->
    <div class="vtkc-panels" style="flex:1; display:flex; gap:6px; padding:6px; overflow:hidden;"></div>

    <!-- Overlay d'erreur (échelle log impossible : valeurs <= 0) -->
    <div class="vtkc-log-error" style="display:none;position:absolute;inset:0;z-index:15;background:#1e1e2e;color:#f38ba8;font:13px/1.5 system-ui,sans-serif;padding:1.5rem;align-items:center;justify-content:center;text-align:center;"></div>

    <!-- Colorbar partagée : labels à GAUCHE du canvas -->
    <div class="vtkc-cb" style="position:relative; width:104px; flex-shrink:0;">
      <span   class="vtkc-cb-title"  style="position:absolute;left:68px;top:50%;transform:translate(-50%,-172px);color:#cdd6f4;font:12px monospace;white-space:nowrap;pointer-events:none;"></span>
      <div    class="vtkc-cb-labels" style="position:absolute;left:0;width:50px;top:50%;transform:translateY(-150px);height:300px;pointer-events:none;"></div>
      <canvas class="vtkc-cb-canvas" width="20" height="300" style="position:absolute;left:58px;top:50%;transform:translateY(-150px);border-radius:3px;border:1px solid #45475a;pointer-events:none;display:block;"></canvas>
    </div>

  </div>

  <!-- Barre de lecture commune (hors des conteneurs vtk) -->
  <VtkPlayerBar>
    <button type="button" class="vp-btn vtkc-link" aria-pressed="true" aria-label="Caméras liées (cliquer pour délier)" title="Caméras liées (cliquer pour délier)">
      <svg class="vp-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"/></svg>
    </button>
    <button type="button" class="vp-btn vtkc-reset" aria-label="Réinitialiser la vue" title="Réinitialiser la vue">
      <svg class="vp-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8M3 3v5h5"/></svg>
    </button>
  </VtkPlayerBar>
</div>

<script>
import { initCompare } from '../scripts/vtk-compare-runtime';

function setup() {
  const obs = new IntersectionObserver(entries => {
    entries.forEach(({ isIntersecting, target }) => {
      if (!isIntersecting) return;
      (target as HTMLElement).dataset.ready = '1';
      obs.unobserve(target);
      initCompare(target as HTMLElement).catch(e => {
        console.error('[VtkFigureCompare]', e);
        const div = (target as HTMLElement).querySelector<HTMLElement>('.vtkc-loading')!;
        const msg = e instanceof Error ? e.message : String(e);
        div.innerHTML = `<span style="color:#f38ba8;font:11px monospace;padding:16px;text-align:center;max-width:80%;">Erreur VTK : ${msg}</span>`;
      });
    });
  }, { threshold: 0.05 });
  document.querySelectorAll<HTMLElement>('.vtkc-figure:not([data-ready])').forEach(el => obs.observe(el));
}
document.readyState === 'loading' ? document.addEventListener('DOMContentLoaded', setup) : setup();
</script>
