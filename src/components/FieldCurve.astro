---
// FieldCurve — figure composite : champ 2D (type VtkFigure) + courbe 1D (type Plot1D)
// côte à côte, pilotés par un slider commun, avec un marqueur mobile sur la courbe.
// Détecté au build par la présence SIMULTANÉE de `curves` ET (`coords`|`triangles`).
// La courbe est rendue par un <Plot1D> embarqué ; le marqueur est piloté par le slider.
//
// JSON schema :
// {
//   // ── CHAMP (obligatoires : coords, triangles, fields, steps) ──
//   "coords":        "/data/coords.npy",            // (N,2) coordonnées des points
//   "triangles":     "/data/tri.npy",               // (T,3) triangulation
//   "fields":        "/data/eps.npy",               // (N,F,S) ou (N,F) champ(s) par pas
//   "displacements": "/data/u.npy",                 // (N,2,S) ou (N,2) — optionnel
//   "images":        "/data/images.npy",            // (H,W,S) uint8, fond image — optionnel
//   "field_index": 0, "field_name": "eps_xx",       // champ unique
//   "fields_config": [{ "index": 0, "name": "eps_xx" }], // OU plusieurs champs (boutons)
//   "cmap": "RdYlGn_r",                             // colormap (défaut RdYlGn_r)
//   "n_colors": 10,                                 // bandes de la colorbar (défaut 10)
//   "opacity": 0.8,                                 // opacité du maillage (défaut 0.8)
//   "label_format": ".2e",                          // format des valeurs (défaut .2e)
//   "label_color": "#a6adc8",                       // couleur des labels de colorbar
//   "vmin": 0, "vmax": 1,                           // échelle de couleur fixe — optionnel
//   "steps": [{ "step": 0 }, { "step": 1 }],        // pilote le slider (+ "image"?/"image_index"?)
//
//   // ── COURBE (obligatoire : curves) ──
//   "x": "/data/eps_glob.npy",                      // axe x PARTAGÉ (.npy ou tableau inline)
//   "title": "\\sigma(\\varepsilon)",               // LaTeX (KaTeX + macros MMC)
//   "xlabel": "\\varepsilon", "ylabel": "\\sigma\\ (\\mathrm{MPa})",
//   "xlog": false, "ylog": false, "legend": true,   // optionnels
//   "curves": [
//     // y requis ; x? écrase l'axe racine ; index? = colonne si .npy 2D ; width?/dash?/color?
//     { "label": "\\sigma", "y": "/data/sig.npy", "color": "#89b4fa", "width": 2 }
//   ],
//
//   // ── MARQUEUR (point mobile sur la courbe, suit le slider) ──
//   "marker_offset": 0,          // indice marqueur = pas + offset (défaut 0)
//   "marker_color": "#f38ba8",   // couleur du point (défaut #f38ba8)
//   "marker_size": 7             // rayon en px (défaut 7)
// }
import Plot1D from './Plot1D.astro';
interface Props { src: string; height?: number | string; }
const { src, height = 460 } = Astro.props;
const heightCss = typeof height === 'string' ? height : `${height}px`;
---

<div class="fc-wrap" data-src={src} style={`container-type:inline-size; height:${heightCss}; background:#1e1e2e; border-radius:0.25rem; overflow:hidden; position:relative;`}>
  <div class="fc-loading" style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;z-index:20;">
    <span style="color:#a6adc8;font:12px monospace;">Chargement…</span>
  </div>

  <div class="fc-figure" style="height:100%; display:flex; flex-direction:column;">
    <div class="fc-row" style="flex:1; display:flex; min-height:0;">
      <!-- Zone champ -->
      <div class="fc-field" style="flex:1; position:relative; min-width:0; overflow:hidden;">
        <div class="fc-fields" style="display:none;position:absolute;top:10px;right:10px;gap:6px;flex-wrap:wrap;justify-content:flex-end;z-index:10;"></div>
        <canvas class="fc-cb-canvas" width="20" height="260" style="position:absolute;right:44px;top:50%;transform:translateY(-130px);border-radius:3px;border:1px solid #45475a;pointer-events:none;z-index:10;display:block;"></canvas>
        <span   class="fc-cb-title"  style="position:absolute;right:20px;top:50%;transform:translateY(-150px);color:#cdd6f4;font:12px monospace;white-space:nowrap;pointer-events:none;z-index:10;"></span>
        <div    class="fc-cb-labels" style="position:absolute;right:68px;top:50%;transform:translateY(-130px);height:260px;pointer-events:none;z-index:10;"></div>
        <button class="fc-reset" title="Réinitialiser la vue" style="display:none;position:absolute;bottom:10px;right:10px;background:#313244;border:1px solid #45475a;border-radius:4px;color:#cdd6f4;font-size:13px;width:28px;height:28px;cursor:pointer;padding:0;z-index:10;">⟳</button>
        <div class="fc-canvas" style="position:absolute;inset:0;overflow:hidden;"></div>
        <div class="fc-log-error" style="display:none;position:absolute;inset:0;z-index:15;background:#1e1e2e;color:#f38ba8;font:13px/1.5 system-ui,sans-serif;padding:1.5rem;align-items:center;justify-content:center;text-align:center;"></div>
        <div class="fc-tooltip" style="display:none;position:absolute;pointer-events:none;z-index:30;background:rgba(24,24,37,.92);border:1px solid #45475a;border-radius:4px;padding:3px 7px;color:#cdd6f4;font:11px monospace;white-space:nowrap;"></div>
      </div>
      <!-- Zone courbe : conteneur relatif (taille via flex, comme .fc-field) +
           grille en position:absolute inset:0 → taille DÉFINIE pour que Safari
           résolve le `1fr` (sinon la grille s'effondre, cf. structure Plot1D). -->
      <div class="fc-curve" style="flex:1; position:relative; min-width:0;">
        <div style="position:absolute; inset:0;">
          <Plot1D src={src} height="100%" />
        </div>
      </div>
    </div>

    <!-- Slider partagé -->
    <div class="fc-controls" style="display:none;padding:8px 12px;background:rgba(24,24,37,.85);align-items:center;gap:6px;flex-shrink:0;">
      <button class="fc-first" title="Premier pas"   style="background:#313244;border:1px solid #45475a;border-radius:4px;color:#cdd6f4;font-size:11px;width:24px;height:24px;cursor:pointer;padding:0;">⏮</button>
      <button class="fc-prev"  title="Pas précédent" style="background:#313244;border:1px solid #45475a;border-radius:4px;color:#cdd6f4;font-size:11px;width:24px;height:24px;cursor:pointer;padding:0;">⏪</button>
      <button class="fc-play"  title="Lecture"       style="background:#313244;border:1px solid #45475a;border-radius:4px;color:#cdd6f4;font-size:11px;width:24px;height:24px;cursor:pointer;padding:0;">▶</button>
      <button class="fc-next"  title="Pas suivant"   style="background:#313244;border:1px solid #45475a;border-radius:4px;color:#cdd6f4;font-size:11px;width:24px;height:24px;cursor:pointer;padding:0;">⏩</button>
      <button class="fc-last"  title="Dernier pas"   style="background:#313244;border:1px solid #45475a;border-radius:4px;color:#cdd6f4;font-size:11px;width:24px;height:24px;cursor:pointer;padding:0;">⏭</button>
      <input  class="fc-slider" type="range" min="0" max="0" step="1" value="0" style="flex:1;accent-color:#89b4fa;height:4px;" />
      <datalist class="fc-datalist"></datalist>
      <span   class="fc-label"  style="color:#a6adc8;font:10px monospace;white-space:nowrap;">1/1</span>
    </div>
  </div>

  <div class="fc-error" style="display:none;position:absolute;inset:0;align-items:center;justify-content:center;z-index:25;"></div>
</div>

<style is:global>
  @container (max-width: 720px) { .fc-row { flex-direction: column; } }
  .fc-curve .u-title  { color: #cdd6f4; font: 13px monospace; }
  .fc-curve .u-legend { color: #cdd6f4; font: 11px monospace; }
  .fc-curve .uplot, .fc-curve .u-wrap { background: transparent; }
</style>

<script>
import { initFieldCurve } from '../scripts/field-curve-runtime';

function setup() {
  const obs = new IntersectionObserver(entries => {
    entries.forEach(({ isIntersecting, target }) => {
      if (!isIntersecting) return;
      (target as HTMLElement).dataset.ready = '1';
      obs.unobserve(target);
      initFieldCurve(target as HTMLElement).catch(e => {
        console.error('[FieldCurve]', e);
        const msg = e instanceof Error ? e.message : String(e);
        const t = target as HTMLElement;
        const ld = t.querySelector<HTMLElement>('.fc-loading'); if (ld) ld.style.display = 'none';
        const box = t.querySelector<HTMLElement>('.fc-error')!;
        box.style.display = 'flex';
        box.innerHTML = `<span style="color:#f38ba8;font:11px monospace;padding:16px;text-align:center;max-width:80%;background:rgba(24,24,37,.95);border-radius:6px;">Erreur figure : ${msg}</span>`;
      });
    });
  }, { threshold: 0.05 });
  document.querySelectorAll<HTMLElement>('.fc-wrap:not([data-ready])').forEach(el => obs.observe(el));
}
document.readyState === 'loading' ? document.addEventListener('DOMContentLoaded', setup) : setup();
</script>
