---
// Figure « courbes 1D » interactive (uPlot). Config JSON via `src`, schéma :
//   { title?, xlabel?, ylabel?, x?, xlog?, ylog?, legend?,
//     curves: [ { y, x?, label?, color?, width?, dash?, index? } ] }
interface Props { src: string; height?: number | string; }
const { src, height = 420 } = Astro.props;
const heightCss = typeof height === 'string' ? height : `${height}px`;
---

<div
  class="plot1d-figure"
  data-src={src}
  style={`height:${heightCss}; position:relative; background:#1e1e2e; border-radius:0.25rem; overflow:hidden;`}
>
  <div class="plot1d-loading" style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;z-index:20;">
    <span style="color:#a6adc8;font:12px monospace;">Chargement…</span>
  </div>
  <div class="plot1d-host" style="position:absolute;inset:8px;display:grid;grid-template-columns:auto 1fr;grid-template-rows:auto 1fr auto;gap:4px;box-sizing:border-box;">
    <div class="plot1d-title"  style="grid-column:1 / 3;grid-row:1;display:none;text-align:center;color:#cdd6f4;font-size:14px;"></div>
    <div class="plot1d-ylabel" style="grid-column:1;grid-row:2;display:none;position:relative;width:1.7em;color:#cdd6f4;">
      <span class="plot1d-ylabel-inner" style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%) rotate(-90deg);white-space:nowrap;"></span>
    </div>
    <div class="plot1d-uplot"  style="grid-column:2;grid-row:2;position:relative;min-width:0;min-height:0;"></div>
    <div class="plot1d-xlabel" style="grid-column:2;grid-row:3;display:none;text-align:center;color:#cdd6f4;"></div>
  </div>
</div>

<script>
import 'uplot/dist/uPlot.min.css';
import 'katex/dist/katex.min.css';
import { initPlot1D } from '../scripts/plot1d-runtime';

function setup() {
  const obs = new IntersectionObserver(entries => {
    entries.forEach(({ isIntersecting, target }) => {
      if (!isIntersecting) return;
      (target as HTMLElement).dataset.ready = '1';
      obs.unobserve(target);
      initPlot1D(target as HTMLElement).catch(e => {
        const div = (target as HTMLElement).querySelector<HTMLElement>('.plot1d-loading')!;
        const msg = e instanceof Error ? e.message : String(e);
        div.innerHTML = `<span style="color:#f38ba8;font:11px monospace;padding:16px;text-align:center;max-width:80%;">Erreur graphique : ${msg}</span>`;
      });
    });
  }, { threshold: 0.05 });
  document.querySelectorAll<HTMLElement>('.plot1d-figure:not([data-ready])').forEach(el => obs.observe(el));
}
document.readyState === 'loading' ? document.addEventListener('DOMContentLoaded', setup) : setup();
</script>

<style is:global>
  .plot1d-figure .u-title  { color: #cdd6f4; font: 13px monospace; }
  .plot1d-figure .u-legend { color: #cdd6f4; font: 11px monospace; }
  .plot1d-figure .uplot,
  .plot1d-figure .u-wrap   { background: transparent; }
</style>
