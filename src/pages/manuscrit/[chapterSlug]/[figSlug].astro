---
import { getCollection } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';
import Nav from '../../../components/Nav.astro';
import VtkFigure from '../../../components/VtkFigure.astro';
import VtkFigure3D from '../../../components/VtkFigure3D.astro';
import VtkFigureCompare from '../../../components/VtkFigureCompare.astro';
import Plot1D from '../../../components/Plot1D.astro';
import FieldCurve from '../../../components/FieldCurve.astro';
import Histogram from '../../../components/Histogram.astro';
import HistogramSeuils from '../../../components/HistogramSeuils.astro';
import '../../../styles/global.css';
import { extractFigures } from '../../../lib/chapter-figures.mjs';

export async function getStaticPaths() {
  const chapters = (await getCollection('chapters')).filter(c => c.data.show);
  return chapters.flatMap(chapter => {
    const figs = extractFigures(chapter.body ?? '');
    return figs.map((fig, i) => ({
      params: { chapterSlug: chapter.slug, figSlug: fig.slug },
      props: { chapter, fig, figIndex: i, figs },
    }));
  });
}

const { chapter, fig, figIndex, figs } = Astro.props;
const { chapterSlug } = Astro.params;

const ext = fig.filename.split('.').pop();
const isJs  = ext === 'js';
const figId = `fig-${figIndex}`;

// Détecte le type de figure VTK d'après les clés du JSON (lu au build).
let isHistSeuils = false;
let isHistogram = false;
let isVtkCompare = false;
let isFieldCurve = false;
let isPlot1D = false;
let isVtk3D = false;
let isVtk   = false;
if (ext === 'json') {
  try {
    const jsonPath = path.join(process.cwd(), 'public', 'figures', 'manuscrit', fig.filename);
    const json = JSON.parse(fs.readFileSync(jsonPath, 'utf8'));
    isHistSeuils = json.histogram_seuils === true;
    isHistogram  = !isHistSeuils && json.histogram === true;
    isVtkCompare = !isHistSeuils && !isHistogram && Array.isArray(json.panels);
    isFieldCurve = !isHistSeuils && !isHistogram && !isVtkCompare && Array.isArray(json.curves) && !!(json.coords || json.triangles);
    isPlot1D     = !isHistSeuils && !isHistogram && !isVtkCompare && !isFieldCurve && Array.isArray(json.curves);
    isVtk3D      = !isHistSeuils && !isHistogram && !isVtkCompare && !isFieldCurve && !isPlot1D && !!(json.dic || json.fe);
    isVtk        = !isHistSeuils && !isHistogram && !isVtkCompare && !isFieldCurve && !isPlot1D && !isVtk3D;
  } catch {
    isVtk = true;
  }
}

const prevFig = figIndex > 0 ? figs[figIndex - 1] : null;
const nextFig = figIndex < figs.length - 1 ? figs[figIndex + 1] : null;
---
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={fig.title} />
    <title>{fig.title} — Manuscrit</title>
  </head>
  <body>
    <Nav />
    <main class="pt-16">
      <div class="max-w-6xl mx-auto px-6 py-8">

        <!-- Fil d'Ariane -->
        <nav class="flex items-center gap-2 text-xs mb-6" style="color: var(--text-muted);">
          <a href="/manuscrit" style="color: var(--accent); text-decoration: none;" class="hover:opacity-80">Manuscrit</a>
          <span>›</span>
          <a href={`/manuscrit/${chapterSlug}`} style="color: var(--accent); text-decoration: none;" class="hover:opacity-80">Chapitre {chapter.data.order} — {chapter.data.title}</a>
        </nav>

        <!-- Titre -->
        <h1 class="font-serif text-2xl font-semibold mb-6" style="color: var(--text);">{fig.title}</h1>

        <!-- Figure -->
        {isVtkCompare && (
          <VtkFigureCompare src={`/figures/manuscrit/${fig.filename}`} height="calc(100dvh - 260px)" />
        )}
        {isHistSeuils && (
          <HistogramSeuils src={`/figures/manuscrit/${fig.filename}`} height="calc(100dvh - 260px)" />
        )}
        {isHistogram && (
          <Histogram src={`/figures/manuscrit/${fig.filename}`} height="calc(100dvh - 260px)" />
        )}
        {isPlot1D && (
          <Plot1D src={`/figures/manuscrit/${fig.filename}`} height="calc(100dvh - 260px)" />
        )}
        {isFieldCurve && (
          <FieldCurve src={`/figures/manuscrit/${fig.filename}`} height="calc(100dvh - 260px)" />
        )}
        {isVtk && (
          <VtkFigure src={`/figures/manuscrit/${fig.filename}`} height="calc(100dvh - 260px)" />
        )}
        {isVtk3D && (
          <VtkFigure3D src={`/figures/manuscrit/${fig.filename}`} height="calc(100dvh - 260px)" />
        )}
        {isJs && (
          <>
            <div
              id={figId}
              class="block rounded"
              style="border: 1px solid var(--border); min-height: 600px;"
            />
            <script src={`/figures/manuscrit/${fig.filename}`} data-target={figId} />
          </>
        )}
        {!isHistSeuils && !isHistogram && !isVtkCompare && !isFieldCurve && !isPlot1D && !isVtk && !isVtk3D && !isJs && (
          <iframe
            src={`/figures/manuscrit/${fig.filename}`}
            width="100%"
            height="600"
            loading="lazy"
            title={fig.title}
            class="block rounded"
            style="border: 1px solid var(--border);"
          />
        )}

        <!-- Navigation précédent / suivant -->
        <div class="flex justify-between mt-8">
          {prevFig ? (
            <a
              href={`/manuscrit/${chapterSlug}/${prevFig.slug}`}
              class="flex items-center gap-2 px-4 py-2 rounded text-sm transition-opacity hover:opacity-80"
              style="border: 1px solid var(--border); background: var(--bg); color: var(--text); text-decoration: none;"
            >
              ← {prevFig.title}
            </a>
          ) : <span />}
          {nextFig ? (
            <a
              href={`/manuscrit/${chapterSlug}/${nextFig.slug}`}
              class="flex items-center gap-2 px-4 py-2 rounded text-sm transition-opacity hover:opacity-80"
              style="border: 1px solid var(--border); background: var(--bg); color: var(--text); text-decoration: none;"
            >
              {nextFig.title} →
            </a>
          ) : <span />}
        </div>
      </div>
    </main>
    <footer class="py-6 text-center text-xs" style="color: var(--text-muted); border-top: 1px solid var(--border);">
      © {new Date().getFullYear()} Thibault Barret
    </footer>
  </body>
</html>

<style is:global>
  .prose-manuscrit {
    color: var(--text);
    font-size: 0.95rem;
    line-height: 1.75;
    max-width: 72ch;
  }
  .prose-manuscrit p        { margin-bottom: 1em; }
  .prose-manuscrit h1       { font-family: serif; font-weight: 700; font-size: 1.35rem; margin: 1.75em 0 0.5em;  color: var(--accent); }
  .prose-manuscrit h2       { font-family: serif; font-weight: 600; font-size: 1.15rem; margin: 1.5em 0 0.5em;   color: var(--heading-2); }
  .prose-manuscrit h3       { font-family: serif; font-weight: 600; font-size: 1rem;    margin: 1.25em 0 0.4em;  color: var(--heading-3); }
  .prose-manuscrit h4       { font-family: serif; font-weight: 600; font-size: 0.9rem;  margin: 1em 0 0.3em;     color: var(--heading-4); font-style: italic; }
  .prose-manuscrit h5       { font-family: serif; font-weight: 500; font-size: 0.85rem; margin: 0.75em 0 0.25em; color: var(--text-muted); }
  .prose-manuscrit ul,
  .prose-manuscrit ol       { padding-left: 1.5em; margin-bottom: 1em; }
  .prose-manuscrit li       { margin-bottom: 0.25em; }
  .prose-manuscrit code     { font-size: 0.85em; background: var(--bg-surface); padding: 0.1em 0.4em; border-radius: 3px; }
  .prose-manuscrit pre      { background: var(--bg-surface); padding: 1em; border-radius: 6px; overflow-x: auto; margin-bottom: 1em; }
  .prose-manuscrit pre code { background: none; padding: 0; }
  .prose-manuscrit strong   { font-weight: 600; }
  .prose-manuscrit em       { font-style: italic; color: var(--text-muted); }
  .prose-manuscrit a        { color: var(--accent); text-decoration: underline; }
</style>
